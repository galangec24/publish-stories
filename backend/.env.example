# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins allowed to call the API (React dev server, production web host)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Public base URL of the React web app; used for PayMongo success/cancel redirects
FRONTEND_BASE_URL=http://localhost:5173

# --- Database (omit to fall back to SQLite for local hacking) ---
DATABASE_URL=postgres://story:story@localhost:5432/story

# --- JWT ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# --- Google Sign-In ---
# Every OAuth client ID whose ID tokens we accept (web, Android, iOS, desktop), comma-separated
GOOGLE_CLIENT_IDS=xxxx-web.apps.googleusercontent.com,xxxx-android.apps.googleusercontent.com,xxxx-ios.apps.googleusercontent.com
# Desktop (Windows) client used for the loopback + PKCE authorization-code flow
GOOGLE_DESKTOP_CLIENT_ID=xxxx-desktop.apps.googleusercontent.com
GOOGLE_DESKTOP_CLIENT_SECRET=

# --- Brevo (transactional email for verification codes / password reset) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@yourdomain.ph
BREVO_SENDER_NAME=Publish Stories
# Optional: Brevo template IDs. When unset, built-in HTML is sent instead.
BREVO_VERIFY_TEMPLATE_ID=
BREVO_RESET_TEMPLATE_ID=
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# --- File storage (production) ---
# Firebase Storage bucket for cover images, e.g. your-project.appspot.com. Leave empty to store on local disk.
GS_BUCKET_NAME=
# Path to the service-account JSON (on Render: a Secret File, e.g. /etc/secrets/gcs.json)
GOOGLE_APPLICATION_CREDENTIALS=

# --- Live translator ---
# Google Cloud Translation API key (Filipino, Cebuano, Ilocano, ...). Empty = free MyMemory fallback.
GOOGLE_TRANSLATE_API_KEY=
# Optional: raises MyMemory's free daily quota
MYMEMORY_EMAIL=

# --- PayMongo ---
PAYMONGO_SECRET_KEY=sk_test_xxx
PAYMONGO_WEBHOOK_SECRET=whsk_xxx
PAYMONGO_LIVE_MODE=False
